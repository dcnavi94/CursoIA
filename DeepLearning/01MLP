import numpy as np
import pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler
from sklearn.metrics import classification_report
from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import Dense

# Simular sensores IoT para sistema hidropónico
np.random.seed(42)
n = 1000

ph = np.random.normal(6.5, 0.5, n)
temperatura = np.random.normal(24, 3, n)
humedad = np.random.normal(70, 10, n)
ec = np.random.normal(2.0, 0.4, n)
oxigeno = np.random.normal(8, 1, n)

# Simular condición de fallo basada en umbrales
fallo = (
    (ph < 5.8) | (ph > 7.2) |
    (temperatura < 20) | (temperatura > 28) |
    (humedad < 50) |
    (ec < 1.5) | (ec > 2.5) |
    (oxigeno < 6)
).astype(int)

# DataFrame
df = pd.DataFrame({
    "ph": ph,
    "temperatura": temperatura,
    "humedad": humedad,
    "ec": ec,
    "oxigeno": oxigeno,
    "fallo": fallo
})

# Preparar datos
X = df.drop("fallo", axis=1)
y = df["fallo"]

scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)

X_train, X_test, y_train, y_test = train_test_split(X_scaled, y, test_size=0.2, random_state=42)

# Definir modelo MLP
model = Sequential([
    Dense(16, activation='relu', input_shape=(X.shape[1],)),
    Dense(8, activation='relu'),
    Dense(1, activation='sigmoid')
])
model.compile(optimizer='adam', loss='binary_crossentropy', metrics=['accuracy'])

# Entrenar
model.fit(X_train, y_train, epochs=20, batch_size=16, verbose=1)

# Evaluar
y_pred = (model.predict(X_test) > 0.5).astype("int32")
print(classification_report(y_test, y_pred))
